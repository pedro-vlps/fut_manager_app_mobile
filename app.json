{
  "expo": {
    "name": "Fut Manager",
    "slug": "fut_manager_app_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fut-manager-icon.png",
    "scheme": "futmanagerappmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/fut-manager-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#152B24",
        "foregroundImage": "./assets/images/fut-manager-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fut-manager-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "enabled": false
    }
  }
}
